  leftBarFill: {fileID: 2144729433}
  rightBarFill: {fileID: 1547077441}
  itemViewer: {fileID: 43818582}
  itemID: 1
  podePausar: 0
  filterBackgroundImage: {fileID: 198554187}
  iconPrefab: {fileID: 7780794242681910549, guid: e8af20497adc1ce4ba8ec1c6d946580f, type: 3}
  iconsContainer: {fileID: 1662570469}
  nerdIcons:
  - {fileID: 21300000, guid: ea8fdde7074d7fa48930d838d794ca92, type: 3}
  - {fileID: 21300000, guid: fd647f345fab1944da3284b670d752af, type: 3}
  - {fileID: 21300000, guid: 1c2b16599973f61458be80660b836a4f, type: 3}
  - {fileID: 21300000, guid: 23ff0b6cd5fca3c42afad968d4ef953a, type: 3}
  rebelIcons: []
  actorIcons: []
  pretendenteSelecionado: 0
  opcoesDeDialogo:
  - tipo: 0
    fala: Pedir ajuda nos estudos
    resposta: "Voc\xEA pede ajuda com os estudos\r\nOs \xF3culos dele brilham em
      empolga\xE7\xE3o \r"
  - tipo: 0
    fala: "Falar que o irm\xE3o verde \xE9 melhor do que o vermelho"
    resposta: "Voc\xEA fala que o irm\xE3o verde \xE9 o melhor dos dois\r\nEle fica
      impressionado com sua sabedoria"
  - tipo: 0
    fala: Oferecer seu lanche para ele
    resposta: "Voc\xEA tenta dividir seu lanche com ele\r\nEle parece relutante em
      aceitar at\xE9 que o est\xF4mago dele diz o contr\xE1rio"
  - tipo: 0
    fala: Falar sobre um jogo desconhecido
    resposta: "Voc\xEA tenta inventar um jogo desconhecido e se mostrar\r\nMisteriosamente
      1% Suco de Ma\xE7\xE3 \xE9 um dos jogos favoritos dele!\r"
  - tipo: 0
    fala: Falar sobre as estrelas
    resposta: "Voc\xEA fala que gosta de ver o c\xE9u estrelado durante a noite\r\nEle
      se empolga bastante e come\xE7a a contar fatos aleat\xF3rios sobre o espa\xE7o"
  - tipo: 0
    fala: "Abra\xE7\xE1-lo"
    resposta: "Voc\xEA d\xE1 um abra\xE7o nele\r\nO golpe parece ter sido efetivo
      at\xE9 demais!\r\nEle ficou sem rea\xE7\xE3o!"
  - tipo: 1
    fala: "Encar\xE1-lo profundamente\r"
    resposta: "Voc\xEA o encara profundamente\u2026\r\nO reflexo do Sol em seus \xF3culos
      atrapalha seu ataque"
  - tipo: 1
    fala: 'Perguntar sobre suas notas

'
    resposta: "Voc\xEA pergunta como ele est\xE1 indo nas provas\r\nEle fala que
      est\xE1 indo bem\u2026 e voc\xEAs n\xE3o falam mais nada"
  - tipo: 1
    fala: "Ficar em sil\xEAncio\r"
    resposta: "Voc\xEA fica em sil\xEAncio\u2026\r\nEle n\xE3o aguenta o sil\xEAncio
      constrangedor e volta o olhar para seu videogame"
  - tipo: 1
    fala: 'Perguntar sobre faculdade

'
    resposta: "Voc\xEA pergunta para ele qual faculdade ele pretende cursar no futuro\r\nEle
      fica sem resposta, essa pergunta n\xE3o \xE9 f\xE1cil pra ningu\xE9m"
  - tipo: 1
    fala: "Dar um aperto de m\xE3o\r"
    resposta: "Voc\xEA d\xE1 um aperto de m\xE3o nele\r\n\u2026\r\r\nPor quanto tempo
      voc\xEA pretende ficar segurando a m\xE3o dele!?"
  - tipo: 1
    fala: Perguntar sobre grade de aulas
    resposta: "Voc\xEA pergunta sobre os hor\xE1rios de aula dele...\r\nAcho que
      ele j\xE1 foi stalkeado o suficiente "
  - tipo: 2
    fala: Perguntar o signo dele
    resposta: "Voc\xEA pergunta qual o signo dele\r\nO clima ficou pesado\u2026"
  - tipo: 2
    fala: "Fazer uma refer\xEAncia \xE0 Guerras Estelares\r"
    resposta: "Voc\xEA faz uma refer\xEAncia \xE0 Guerras Estelares\r\nEle come\xE7a
      a explicar detalhadamente o motivo do som n\xE3o se propagar no espa\xE7o \t"
  - tipo: 2
    fala: 'Falar algo inteligente

'
    resposta: "Voc\xEA fala algo que viu nas redes sociais\r\nEle volta a jogar seu
      videogame depois que voc\xEA questionou teorias j\xE1 provadas"
  - tipo: 2
    fala: Falar uma curiosidade
    resposta: "Voc\xEA aponta para um formigueiro pr\xF3ximo e come\xE7a a falar
      coisas sobre formigas\r\nVoc\xEA percebe que ele est\xE1 tremendo de medo desde
      que voc\xEA apontou o formigueiro"
  - tipo: 2
    fala: Perguntar sobre roupas
    resposta: "Voc\xEA pergunta onde ele comprou suas roupas\nEle parece confuso
      e diz que esse \xE9 o uniforme da escola"
  - tipo: 2
    fala: "Experimentar \xF3culos"
    resposta: "Voc\xEA rouba os \xF3culos dele e os coloca na sua cara\nEle fica
      furioso, mas de um jeito inofensivo"
